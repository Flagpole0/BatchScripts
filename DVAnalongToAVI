#!/usr/bin/env bash
# capture-tape.sh - capture one Digital8 / Hi8 / Video8 tape over FireWire as a raw DV master.
#
# Usage:
#   ./capture-tape.sh                                   interactive: prompts for everything
#   ./capture-tape.sh [-t d8|hi8] [-n "notes"] TAPE_ID  non-interactive
#
#   -t d8   Digital8 tape (default): splits files at recording breaks, names them by record date/time
#   -t hi8  Hi8 / Video8 tape played through the D8 camcorder: one continuous file (no DV date data to split on)
#   -n      Free-text notes saved with the tape (label text, who's on it, condition)
#
# Environment:
#   ARCHIVE_ROOT  where tapes are stored (default: ~/tape-archive)
#   ACCESS=1      also make 60p H.264 viewing copies after capture (needs ffmpeg)
#
# Layout per tape:
#   $ARCHIVE_ROOT/TAPE_ID/master/*.dv       raw DV stream, untouched (the archival master)
#   $ARCHIVE_ROOT/TAPE_ID/TAPE_ID.sha256    checksums of the masters
#   $ARCHIVE_ROOT/TAPE_ID/metadata.txt      tape info, file list, durations
#   $ARCHIVE_ROOT/TAPE_ID/capture.log       dvgrab output
#   $ARCHIVE_ROOT/TAPE_ID/access/*.mp4      optional viewing copies
#
# Stop the capture with Ctrl+C when the tape ends; the script then finishes checksums and metadata.

set -euo pipefail

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

TAPE_TYPE="d8"
NOTES=""
while getopts ":t:n:h" opt; do
  case "$opt" in
    t) TAPE_TYPE="$OPTARG" ;;
    n) NOTES="$OPTARG" ;;
    h) usage 0 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -le 1 ]] || usage

ARCHIVE_ROOT="${ARCHIVE_ROOT:-$HOME/tape-archive}"

# --- Interactive prompts (used when no TAPE_ID is given on the command line) ---
if [[ $# -eq 0 ]]; then
  echo "=== Tape capture ==="
  echo

  while :; do
    read -r -p "Tape ID (letters, numbers, - and _; e.g. 1998-xmas-01): " TAPE_ID
    [[ "$TAPE_ID" =~ ^[A-Za-z0-9_-]+$ ]] && break
    echo "  Invalid ID, try again."
  done

  echo "Tape type:"
  echo "  1) Digital8 (split at recording breaks, named by record date)"
  echo "  2) Hi8 / Video8 analog (one continuous file)"
  while :; do
    read -r -p "Choose 1 or 2 [1]: " choice
    case "${choice:-1}" in
      1) TAPE_TYPE="d8"; break ;;
      2) TAPE_TYPE="hi8"; break ;;
      *) echo "  Enter 1 or 2." ;;
    esac
  done

  read -r -p "Notes (label text, who's on it, condition) [none]: " NOTES

  read -r -p "Make 60p viewing copies after capture? (y/N): " yn
  [[ "$yn" =~ ^[Yy] ]] && ACCESS=1 || ACCESS=0

  read -r -p "Archive folder [$ARCHIVE_ROOT]: " root
  ARCHIVE_ROOT="${root:-$ARCHIVE_ROOT}"
  ARCHIVE_ROOT="${ARCHIVE_ROOT/#\~/$HOME}"

  echo
  echo "Summary:"
  echo "  Tape ID:        $TAPE_ID"
  echo "  Type:           $TAPE_TYPE"
  echo "  Notes:          ${NOTES:-none}"
  echo "  Viewing copies: $([[ $ACCESS == 1 ]] && echo yes || echo no)"
  echo "  Archive folder: $ARCHIVE_ROOT"
  read -r -p "Proceed? (Y/n): " yn
  [[ "${yn:-Y}" =~ ^[Yy] ]] || { echo "Cancelled."; exit 0; }
  echo
else
  TAPE_ID="$1"
fi

[[ "$TAPE_ID" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "TAPE_ID may only contain letters, numbers, - and _"; exit 1; }
[[ "$TAPE_TYPE" == "d8" || "$TAPE_TYPE" == "hi8" ]] || { echo "-t must be d8 or hi8"; exit 1; }
TAPE_DIR="$ARCHIVE_ROOT/$TAPE_ID"
MASTER_DIR="$TAPE_DIR/master"
LOG="$TAPE_DIR/capture.log"

# --- Preflight -------------------------------------------------------------
command -v dvgrab >/dev/null || { echo "dvgrab not found. Install it (e.g. sudo apt install dvgrab)."; exit 1; }

if ! compgen -G "/dev/fw*" >/dev/null; then
  echo "No /dev/fw* devices. Check the FireWire card: lsmod | grep firewire ; dmesg | grep -i firewire"
  exit 1
fi
for dev in /dev/fw*; do
  if [[ ! -r "$dev" || ! -w "$dev" ]]; then
    echo "Warning: no read/write access to $dev. If capture fails, add yourself to the 'video' group or add a udev rule."
  fi
done

if compgen -G "$MASTER_DIR/*.dv" >/dev/null; then
  echo "Masters already exist in $MASTER_DIR. Refusing to overwrite. Pick a new TAPE_ID or move the old files."
  exit 1
fi

mkdir -p "$MASTER_DIR"

echo "Tape:    $TAPE_ID ($TAPE_TYPE)"
echo "Saving:  $MASTER_DIR"
echo
echo "Insert the tape, set the camcorder to playback (VCR/PLAY) mode, then press Enter."
echo "The tape rewinds and capture starts. Press Ctrl+C when the tape reaches the end."
read -r

# --- Capture ---------------------------------------------------------------
args=(--rewind --format raw --size 0 --showstatus)
if [[ "$TAPE_TYPE" == "d8" ]]; then
  args+=(--autosplit --timestamp)
fi

STARTED="$(date -Is)"
{
  echo "=== Capture started $STARTED ==="
  echo "dvgrab ${args[*]} $MASTER_DIR/${TAPE_ID}_"
} >>"$LOG"

# Ctrl+C stops dvgrab cleanly; the script keeps going to checksum what was captured.
trap 'echo; echo "Stopping capture..."' INT
set +e
dvgrab "${args[@]}" "$MASTER_DIR/${TAPE_ID}_" 2>&1 | tee -i -a "$LOG"
DVGRAB_STATUS=${PIPESTATUS[0]}
set -e
trap - INT
FINISHED="$(date -Is)"
echo "=== Capture ended $FINISHED (dvgrab exit $DVGRAB_STATUS) ===" >>"$LOG"

shopt -s nullglob
files=("$MASTER_DIR"/*.dv)
shopt -u nullglob
if [[ ${#files[@]} -eq 0 ]]; then
  echo "No .dv files were captured. Check the cable, the camcorder mode, and $LOG."
  exit 1
fi

# --- Checksums -------------------------------------------------------------
echo "Writing checksums..."
( cd "$MASTER_DIR" && sha256sum -- *.dv ) >"$TAPE_DIR/$TAPE_ID.sha256"

# --- Metadata --------------------------------------------------------------
duration_of() {
  if command -v ffprobe >/dev/null; then
    local s
    s="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null || true)"
    [[ -n "$s" ]] && printf '%02d:%02d:%02d' $(( ${s%.*} / 3600 )) $(( ${s%.*} % 3600 / 60 )) $(( ${s%.*} % 60 )) && return
  fi
  echo "unknown"
}

{
  echo "Tape ID:        $TAPE_ID"
  echo "Tape type:      $TAPE_TYPE"
  echo "Notes:          ${NOTES:-none}"
  echo "Captured by:    $(whoami)@$(hostname)"
  echo "Capture start:  $STARTED"
  echo "Capture end:    $FINISHED"
  echo "Method:         FireWire DV via dvgrab (raw DV stream, unmodified)"
  echo "Total size:     $(du -sh "$MASTER_DIR" | cut -f1)"
  echo
  echo "Files:"
  for f in "${files[@]}"; do
    printf '  %-48s %s\n' "$(basename "$f")" "$(duration_of "$f")"
  done
} >"$TAPE_DIR/metadata.txt"

# --- Optional viewing copies ----------------------------------------------
if [[ "${ACCESS:-0}" == "1" ]]; then
  if command -v ffmpeg >/dev/null; then
    mkdir -p "$TAPE_DIR/access"
    for f in "${files[@]}"; do
      out="$TAPE_DIR/access/$(basename "${f%.dv}").mp4"
      echo "Making viewing copy: $(basename "$out")"
      # bwdif mode=1: one frame per field (59.94p for NTSC); scale to square pixels for modern players
      ffmpeg -nostdin -hide_banner -loglevel warning -i "$f" \
        -vf "bwdif=mode=1,scale='trunc(iw*sar/2)*2':ih,setsar=1" \
        -c:v libx264 -preset slow -crf 18 -pix_fmt yuv420p \
        -c:a aac -b:a 192k -movflags +faststart "$out"
    done
  else
    echo "ACCESS=1 set but ffmpeg not found; skipping viewing copies."
  fi
fi

echo
echo "Done: ${#files[@]} file(s) in $MASTER_DIR"
echo "Verify later with: (cd \"$MASTER_DIR\" && sha256sum -c ../$TAPE_ID.sha256)"
